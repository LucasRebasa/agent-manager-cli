{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "github": {
            "type": "remote",
            "url": "https://api.githubcopilot.com/mcp/",
            "headers": {
                "Authorization": "Bearer YOUR_GITHUB_TOKEN_HERE"
            },
            "enabled": true
        }
    }
  }